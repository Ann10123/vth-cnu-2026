# Скопіюйте цей файл у .env.cloud та заповніть власними даними з GCP та Neon
GCP_PROJECT_ID=valorant-hub-student-01
GCP_REGION=us-central1

# Direct connection strings з Neon Console (без -pooler, з ?sslmode=require)
NEON_ROSTER_JDBC_URL=jdbc:postgresql://ep-your-endpoint.us-east-1.aws.neon.tech/roster_db?sslmode=require
NEON_ANALYTICS_JDBC_URL=jdbc:postgresql://ep-your-endpoint.us-east-1.aws.neon.tech/analytics_db?sslmode=require
NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=replace_with_your_neon_password
